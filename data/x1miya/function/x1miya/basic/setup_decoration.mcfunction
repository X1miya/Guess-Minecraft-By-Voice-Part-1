# Setup Level decorations automatically using Item Displays
# Spawns lobby signs, level signs, 3D radio models, floating heads with embedded skins, and click hitboxes

# 1. Targeted cleanup (never deletes unrelated text_displays outside lobbies/levels)
execute at @e[type=item_display,tag=head_display] run kill @e[type=text_display,distance=..2.2]
kill @e[type=text_display,tag=level_sign]
kill @e[type=text_display,tag=head_label]
kill @e[type=text_display,tag=lobby_sign]
execute positioned -649.5 -13 -2551.5 run kill @e[type=text_display,distance=..10]
execute positioned -406.0 -12 -2482.5 run kill @e[type=text_display,distance=..10]
kill @e[type=item_display,tag=head_display]
kill @e[type=item_display,tag=radio_display]
kill @e[type=interaction,tag=right]
kill @e[type=interaction,tag=notright]
kill @e[type=interaction,tag=voice]

